<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ requires runtime permission to post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to keep listening reliably after boot / app kill (optional, user can disable) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Used once a day to repaint the widget and the shade notification the moment the date
      changes. Without an exact alarm the numbers sit stale all morning on an idle phone, because
      the widget's own update cycle is skipped during Doze. On API 33+ this is not granted by
      default; DayRolloverScheduler checks canScheduleExactAlarms() and degrades to an inexact
      alarm rather than crashing.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
      Needed so the "監視アプリ選択" screen can list all installed apps (banking/card apps are
      unknown ahead of time, so we can't declare narrow <queries> entries for them). This is fine
      for a personal prototype sideloaded via Android Studio; if this app is ever published on
      Google Play, QUERY_ALL_PACKAGES requires a Play Console declaration/justification, or you'd
      need to switch to an explicit <queries> allow-list of known banking/card app packages.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".BudgetGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetGuard"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BudgetGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          NotificationListenerService: this is what lets BudgetGuard "see" spend
          notifications posted by other apps (credit card apps, bank apps, PayPay, etc).
          The user must explicitly grant this in
          Settings > Apps > Special access > Notification access.

          exported MUST be true: the system_server binds this service from outside the app, so
          exported="false" makes the bind silently fail — the app still shows up in the
          notification-access list and can be toggled on, but onNotificationPosted is never
          called. Access is still safe because only a caller holding
          BIND_NOTIFICATION_LISTENER_SERVICE (i.e. the system) can bind.
        -->
        <service
            android:name=".notification.SpendingNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Home screen widget. exported MUST be true here for the same reason as the notification
          listener above: the launcher/system delivers APPWIDGET_UPDATE from outside the app.
        -->
        <receiver
            android:name=".widget.BalanceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/balance_widget_info" />
        </receiver>

        <!--
          Day rollover. exported MUST be true for the same reason as the two components above:
          BOOT_COMPLETED and TIME_SET are delivered by the system, from outside this app's UID.
          The alarm itself arrives as an explicit intent, so nothing else can usefully reach it.
        -->
        <receiver
            android:name=".schedule.DayRolloverReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
